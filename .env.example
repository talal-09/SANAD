# Development only. Generate a unique value; never commit the real secret.
# The local settings loader maps SECRET_KEY to DJANGO_SECRET_KEY.
SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters

# Cloudinary (optional). Copy the CLOUDINARY_URL from the Cloudinary Console.
# Never expose this value in browser code or commit it to Git. Adding it enables
# private cloud storage unless SANAD_CLOUDINARY_ENABLED is explicitly set to 0.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name?secure=true
# SANAD_CLOUDINARY_ENABLED=1
# SANAD_CLOUDINARY_FOLDER=sanad/private-medical

# Optional AI runtime overrides.
# SANAD_AI_PYTHON=C:\path\to\ai-venv\Scripts\python.exe
# SANAD_AI_MODEL_ROOT=C:\path\to\lung_nodule_ct_detection
